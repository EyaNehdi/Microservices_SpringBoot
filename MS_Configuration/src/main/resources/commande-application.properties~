spring.application.name=commande
server.port=8066
# MongoDB Configuration
spring.data.mongodb.host=mongodb
spring.data.mongodb.port=27017
spring.data.mongodb.database=commande
#eureka registration
eureka.client.service-url.defaultZone=http://eurekaserver:8087/eureka/
eureka.client.register-with-eureka=true
eureka.client.fetch-registry=true

# Disable DataSource Auto-Configuration
spring.autoconfigure.exclude=org.springframework.boot.autoconfigure.jdbc.DataSourceAutoConfiguration


welcome.message=Hello from Commande Service
spring.cloud.config.enabled=true
spring.cloud.config.uri=http://localhost:8888
spring.config.import=optional:configserver:http://localhost:8888/